SELECT 
    p.product_id,
    ISNULL(t.new_price, 10) AS price
FROM
    (SELECT DISTINCT product_id FROM Products) p
LEFT JOIN
    (
        SELECT 
            product_id,
            new_price
        FROM Products pr1
        WHERE change_date = (
            SELECT MAX(change_date)
            FROM Products pr2
            WHERE pr2.product_id = pr1.product_id
              AND pr2.change_date <= '2019-08-16'
        )
    ) t
ON p.product_id = t.product_id;
